# Copy to .env. Never commit credentials. Read docs/DEPLOYMENT.md.
ENVIRONMENT=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/quantumlearn
# Generate a random 32+ character secret. Production refuses this empty value.
SECRET_KEY=
# Compose database password: use URL-safe random characters.
POSTGRES_PASSWORD=
# JSON array of browser origins; production requires HTTPS.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Backend-only AI settings. Choose a model enabled for your provider account.
OPENAI_API_KEY=your-openai-api-key
AI_MODEL=gpt-4.1-mini

# Production transactional email uses Resend's HTTPS API (backend-only secret).
RESEND_API_KEY=
# Local fallback SMTP. STARTTLS by default; use SMTP_SSL=true for implicit TLS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SSL=false
SMTP_EMAIL=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_REPLY_TO=

TTS_PROVIDER=openai
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=marin
TTS_CACHE_PATH=.cache/narration.sqlite3
TTS_CACHE_MAX_BYTES=134217728
TTS_CACHE_TTL_SECONDS=604800
TTS_DAILY_CHAR_LIMIT=250000
TTS_REQUESTS_PER_MINUTE=40
TTS_MAX_CONCURRENT=2

# Frontend BUILD settings; copy to frontend/.env.local for local next builds.
# Empty uses the same-origin /api proxy. Compose sets proxy destination itself.
NEXT_PUBLIC_API_URL=
API_PROXY_URL=http://127.0.0.1:8000

# Caddy/Let's Encrypt certificate contact. Required by the VPS deployment.
ACME_EMAIL=ops@example.com
